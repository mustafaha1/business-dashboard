# ============================================
# Business Dashboard Backend Configuration
# ============================================

# ============================================
# Server Configuration
# ============================================
# HTTP port (default: 3000)
PORT=3000

# HTTPS port (default: 3443)
HTTPS_PORT=3443

# Environment: development, production, test
NODE_ENV=development

# ============================================
# Security Configuration
# ============================================
# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate a secure random string: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token Expiration (default: 7d)
# Format: number + unit (s, m, h, d)
JWT_EXPIRES_IN=7d

# Bcrypt password hashing rounds (default: 12)
# Higher = more secure but slower
BCRYPT_ROUNDS=12

# ============================================
# HTTPS Configuration
# ============================================
# Enable HTTPS server (default: false)
ENABLE_HTTPS=false

# SSL Certificate Paths (relative to project root)
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for CORS
# Use * for all origins (development only)
# For production, specify your domain: https://yourdomain.com
CORS_ORIGIN=*

# ============================================
# Database Configuration
# ============================================
# SQLite database file path
DB_PATH=./database.sqlite

# ============================================
# Rate Limiting
# ============================================
# API rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window (default: 100)
RATE_LIMIT_MAX=100

# Auth rate limit window in milliseconds (default: 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Max login attempts per window (default: 10)
AUTH_RATE_LIMIT_MAX=10

# ============================================
# Session Configuration
# ============================================
# Session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600

# Max login attempts before lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in seconds (default: 900 = 15 minutes)
LOCKOUT_DURATION=900

# ============================================
# Feature Flags
# ============================================
# Require login to access dashboard (default: true)
REQUIRE_LOGIN=true

# Enable user registration (default: false - admin only)
ENABLE_REGISTRATION=false

# Enable password reset (default: false)
ENABLE_PASSWORD_RESET=false

# ============================================
# Email Configuration (for password reset)
# ============================================
# SMTP Host
# SMTP_HOST=smtp.gmail.com

# SMTP Port
# SMTP_PORT=587

# SMTP Username
# SMTP_USER=your-email@gmail.com

# SMTP Password
# SMTP_PASS=your-app-password

# From Email Address
# FROM_EMAIL=noreply@yourdomain.com

# ============================================
# Logging Configuration
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable request logging (default: true in development)
ENABLE_REQUEST_LOGGING=true

# ============================================
# Production Settings
# ============================================
# DO NOT USE THESE IN DEVELOPMENT

# Trust proxy (required when behind reverse proxy like Nginx)
# TRUST_PROXY=true

# Force HTTPS redirect
# FORCE_HTTPS=true

# Content Security Policy nonce
# CSP_NONCE=true